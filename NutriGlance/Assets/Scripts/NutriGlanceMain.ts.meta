  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">NutriGlanceMain – look at a product to see its Nutri-Score; pinch to pin</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject cameraObject {"hint":"The Specs camera; its forward ray is the head-gaze"}'
    - '// @input AssignableType_1 yogurt {"hint":"Yogurt placeholder product (left of the shelf)"}'
    - '// @input AssignableType_2 snackBar {"hint":"Snack bar placeholder product (right of the shelf)"}'
    - '// @input AssignableType_3 mysteryBox {"hint":"Product with no assigned grade — must never show a badge"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Gaze & timing</span>"}'
    - '// @ui {"widget":"group_start", "label":"Gaze & timing"}'
    - '// @input float dwellSec = 0.5 {"hint":"Seconds of steady gaze on a product before its badge appears", "widget":"slider", "min":0.1, "max":2, "step":0.05}'
    - '// @input float lingerSec = 1 {"hint":"Seconds an unpinned badge stays at full strength after you look away (lets you compare two products)", "widget":"slider", "min":0, "max":3, "step":0.1}'
    - '// @input float fadeOutSec = 0.5 {"hint":"Seconds an unpinned badge takes to fade out", "widget":"slider", "min":0.1, "max":2, "step":0.05}'
    - '// @input float pinnedClearSec = 2 {"hint":"Seconds of looking away from every product before pinned badges clear", "widget":"slider", "min":0.5, "max":6, "step":0.1}'
    - '// @input float pinnedOpacity = 0.45 {"hint":"Opacity of a pinned badge while you look elsewhere (dimmed)", "widget":"slider", "min":0.1, "max":1, "step":0.05}'
    - '// @input float sfxVolume = 0.7 {"hint":"Volume of the reveal / pin / unpin sound cues (0 = silent)", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Grade colors (bright: the display is additive)</span>"}'
